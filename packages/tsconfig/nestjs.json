{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS: Node ESM server compiled by tsc, with decorator metadata for dependency injection",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  }
}
