{
  "name": "web-server-demo",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS GraphQL API for the Trello-like web demo, storing boards, lists and cards in SQLite.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "schema": "node --env-file-if-exists=.env dist/generate-schema.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apollo/server": "catalog:",
    "@as-integrations/express5": "catalog:",
    "@nestjs/apollo": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "express": "catalog:",
    "graphql": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
