# Ollama Cloud API key (required). Create one at https://ollama.com → Settings → Keys.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
# One of the free-tier cloud models: gpt-oss:120b, gpt-oss:20b, gemma4:31b,
# nemotron-3-nano:30b, nemotron-3-super, nemotron-3-ultra
AI_MODEL=gpt-oss:120b
# Set to true only if you've added paid credits and want a non-free model.
AI_ALLOW_ANY_MODEL=false
# How hard the model thinks before answering: low | medium | high | off
AI_THINK=low
PORT=8787
# The Chrome extension's origin (its id is pinned by the manifest key).
ALLOWED_ORIGINS=chrome-extension://dmnphemkaphmemfkmonbngjofhmbenck
MAX_TOOL_RESULT_CHARS=20000
